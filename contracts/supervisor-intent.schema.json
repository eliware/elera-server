{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliware.dev/contracts/supervisor-intent.schema.json",
  "title": "Supervisor intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "cluster", "mariadb", "routing", "drain"],
  "properties": {
    "apiVersion": { "const": "elera.eliware.dev/v1alpha1" },
    "kind": { "const": "SupervisorIntent" },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "members"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "address"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "address": { "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    },
    "mariadb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "dataDir": { "type": "string", "minLength": 1 },
        "binlogFormat": { "enum": ["ROW", "STATEMENT", "MIXED"] }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthIntervalMs"],
      "properties": {
        "healthIntervalMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "weights": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
      }
    },
    "drain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryTimeoutMs"],
      "properties": {
        "queryTimeoutMs": { "type": "integer", "minimum": 1 },
        "shutdownTimeoutMs": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
