MARIADB_DATA_DIR=/var/lib/mysql
ROOT_TOKEN=replace-with-root-token
ELERA_CREDENTIAL_KEY=replace-with-secret-key
# Optional settings. Uncomment only when you need them.
# ELERA_CONFIG_STATE_DIR=/var/lib/mysql/elera-state
# ELERA_HTTP_PORT=8080
# ELERA_QUERY_TIMEOUT_MS=5000
# ELERA_DRAIN_TIMEOUT_MS=45000
# ELERA_SHUTDOWN_TIMEOUT_MS=60000
# ELERA_STARTUP_TIMEOUT_MS=30000
# ELERA_NODE_SQL_PORT=3306
# ELERA_CLUSTER_SIZE=1
# ELERA_APPLICATION=default
# ELERA_PEER_TOKEN=replace-with-peer-token
# ELERA_LOAD_BALANCER_ENDPOINT=http://load-balancer.example.test/drain
# ELERA_ASSIGNMENTS_PATH=/var/lib/mysql/elera-state/routing-assignments.json
# ELERA_EVENT_VERSION_PATH=/run/elera/routing-event-version.json
# ELERA_OBSERVATION_STATE_PATH=/run/elera/observations.json
# ELERA_RECOVERY_DECISION_PATH=/run/elera/cold-recovery.json
# ELERA_EXPLICIT_START_MODE=join
# SUPERVISOR_INTENT_JSON={}
